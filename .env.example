# ── Provider selection ─────────────────────────────────────────────
# All default to "mock" so the pipeline runs end-to-end with zero keys.
# Swap to a real provider by setting the name AND its API key.

# transcription: mock | assemblyai | deepgram
TRANSCRIPTION_PROVIDER=mock
ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=

# llm: mock | anthropic
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# embeddings: mock | anthropic-voyage (placeholder for real)
EMBEDDINGS_PROVIDER=mock

# ── Quality gates (NFR-1) ──────────────────────────────────────────
# Segments below this confidence are flagged; assets above the flag
# ratio are auto-held for faculty review.
CONFIDENCE_FLAG_THRESHOLD=0.75
ASSET_AUTOHOLD_FLAG_RATIO=0.15

# ── Persistence ─────────────────────────────────────────────────────
# sqlite (default, zero-dep) or postgres (prod target — needs a real DB).
REPO_DRIVER=sqlite
DATABASE_URL=
# vector(n) column width for the Postgres adapter — must match whatever
# embeddings provider is configured, and can't change after the chunks
# table is first created.
EMBEDDING_VECTOR_DIM=256

# ── Security ─────────────────────────────────────────────────────────
# Set to 1 ONLY if a trusted reverse proxy in front of this app overwrites
# X-Forwarded-For before forwarding — otherwise it's client-suppliable and
# trusting it would let anyone bypass the login rate limiter.
TRUST_PROXY=0
# Session cookies get the `Secure` attribute automatically when
# NODE_ENV=production. Override explicitly (0/1) for setups that don't set
# NODE_ENV, e.g. staging behind a TLS-terminating proxy.
COOKIE_SECURE=
