# ── Provider selection ─────────────────────────────────────────────
# All default to "mock" so the pipeline runs end-to-end with zero keys.
# Swap to a real provider by setting the name AND its API key.
#
# The free-tier real stack needs exactly ONE key (GROQ_API_KEY, from
# console.groq.com — free, no card required):
#   TRANSCRIPTION_PROVIDER=groq
#   LLM_PROVIDER=groq
#   EMBEDDINGS_PROVIDER=local   (runs in-process, no key/network needed)

# transcription: mock | assemblyai | deepgram | groq
TRANSCRIPTION_PROVIDER=mock
ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=
GROQ_API_KEY=

# llm: mock | anthropic | groq
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
# Leave empty to use the selected provider's own default model
# (groq -> openai/gpt-oss-120b, anthropic -> claude-sonnet-5).
LLM_MODEL=

# embeddings: mock | local (runs @huggingface/transformers in-process, no
# API key or network call — the only embeddings option with zero external
# dependency)
EMBEDDINGS_PROVIDER=mock

# ── Quality gates (NFR-1) ──────────────────────────────────────────
# Segments below this confidence are flagged; assets above the flag
# ratio are auto-held for faculty review.
CONFIDENCE_FLAG_THRESHOLD=0.75
ASSET_AUTOHOLD_FLAG_RATIO=0.15

# ── Background processing ───────────────────────────────────────────
# Processing a recording (transcription + several LLM calls) runs on a
# background job queue, not inline in the HTTP request — a slow/rate-limited
# provider no longer holds a request open. This is how many lectures the
# in-process queue processes at once; raise it on a bigger box. Swapping in
# a durable backend (Redis/BullMQ, Postgres) for a multi-replica deployment
# means implementing the same JobQueue interface — see src/queue/job-queue.ts.
QUEUE_CONCURRENCY=2

# ── Persistence ─────────────────────────────────────────────────────
# sqlite (default, zero-dep) or postgres (prod target — needs a real DB).
REPO_DRIVER=sqlite
DATABASE_URL=
# vector(n) column width for the Postgres adapter — must match whatever
# embeddings provider is configured, and can't change after the chunks
# table is first created.
EMBEDDING_VECTOR_DIM=256

# ── Capture-system / LMS integrations (moat #4) ─────────────────────
# Pull recordings in, and push approved minutes/notes back out, through the
# tools people already use — no new app to adopt. Both default to "mock" so
# the import/publish flow is fully testable with zero credentials.

# capture: mock | zoom | echo360 | panopto | kaltura
# zoom is the one real adapter (echo360/panopto/kaltura are tested stubs that
# fail clearly, pending institutional API credentials). Needs a Zoom App
# Marketplace "Server-to-Server OAuth" app (not the old deprecated JWT apps).
CAPTURE_SOURCE=mock
# Which recordings to pull, in the capture system's own terms. For zoom: "me"
# (the OAuth app's own account, the default when CAPTURE_SOURCE=zoom) or a Zoom
# user id/email. Ignored by the mock source.
# This is the organisation-wide default; each course can set its own (Courses ->
# Manage -> "LMS / capture id"), which takes precedence.
CAPTURE_EXTERNAL_ID=
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# lms: mock | slack | canvas | moodle | blackboard
# slack and canvas are the real adapters (moodle/blackboard are tested stubs
# that fail clearly, pending LTI/API credentials).
#  - slack: the natural distribution target for a company/team without an LMS:
#    push approved minutes, decisions and action items straight into the channel
#    people already read. Create a webhook at https://api.slack.com/messaging/webhooks
#  - canvas: for universities. Each approved item becomes a Canvas Page in the
#    course (re-publishing updates the same page, no duplicates). Pages are
#    created PUBLISHED, so students see them: "Publish approved" is the release.
LMS_CONNECTOR=mock
# Where to publish, in the LMS's own terms: a numeric Canvas course id, or its
# SIS course id (anything non-numeric is sent as sis_course_id:<value>).
# Organisation-wide default; each course can set its own, which takes precedence.
LMS_COURSE_ID=
SLACK_WEBHOOK_URL=
# Your institution's own Canvas host (https only: the token is sent to it) and
# an API access token (Canvas: Account -> Settings -> New Access Token).
CANVAS_BASE_URL=
CANVAS_ACCESS_TOKEN=

# email: mock | resend | ses | sendgrid (the latter two are tested stubs,
# pending API credentials). Used for signup verification and self-service
# password reset — the roadmap's last named gap. Links inside these emails use
# APP_BASE_URL, so set that for a real deployment (defaults to localhost:3000).
# resend needs an account at https://resend.com and a verified sender.
EMAIL_PROVIDER=mock
RESEND_API_KEY=
EMAIL_FROM=
APP_BASE_URL=http://localhost:3000

# ── Audit integrity ──────────────────────────────────────────────────
# Every audit event is hash-chained to the one before it, so editing, deleting
# or reordering a past event is detected (the Audit page shows "Chain verified"
# or "Chain broken at event N"). Set a key and the hashes become HMACs, so
# someone who can only write to the database can't simply recompute the chain.
# Set it BEFORE first use and keep it somewhere safe: changing or losing it makes
# earlier events fail verification. Leave empty for plain SHA-256.
AUDIT_CHAIN_KEY=

# ── Security ─────────────────────────────────────────────────────────
# Set to 1 ONLY if a trusted reverse proxy in front of this app overwrites
# X-Forwarded-For before forwarding — otherwise it's client-suppliable and
# trusting it would let anyone bypass the login rate limiter.
TRUST_PROXY=0
# Session cookies get the `Secure` attribute automatically when
# NODE_ENV=production. Override explicitly (0/1) for setups that don't set
# NODE_ENV, e.g. staging behind a TLS-terminating proxy.
COOKIE_SECURE=
# "Quick demo" sign-in: pick a role, no password, into a shared sample
# organisation. Real accounts (sign up / sign in with email + password) are
# always available. Defaults to on in development and OFF in production, because
# everyone using it shares one organisation (including its admin role).
# Set DEMO_LOGIN=1 only for a throwaway showcase deploy.
DEMO_LOGIN=1
