{
  "name": "lecture-intelligence-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Compliant AI layer that turns in-person lecture recordings into study-ready, searchable knowledge.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "demo": "node --experimental-strip-types src/demo.ts",
    "demo:service": "node --experimental-strip-types src/demo-service.ts",
    "web": "node --experimental-strip-types src/web/server.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "lecture-capture",
    "meeting-intelligence",
    "rag",
    "education",
    "ai"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "pg": "^8.22.0"
  }
}
